{
  "openapi": "3.0.1",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "tags": [
    {
      "name": "Event",
      "description": "Event management and Ticketmaster integration endpoints"
    }
  ],
  "paths": {
    "/event": {
      "get": {
        "tags": [
          "Event"
        ],
        "summary": "Get all events",
        "description": "Returns a list of all events",
        "operationId": "getAllEvents",
        "responses": {
          "200": {
            "description": "Events fetched successfully",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EventResponseDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Event"
        ],
        "summary": "Create a new event",
        "description": "Creates a new event record",
        "operationId": "createEvent",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Event created successfully",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponseDto"
                }
              }
            }
          }
        }
      }
    },
    "/event/{id}": {
      "get": {
        "tags": [
          "Event"
        ],
        "summary": "Get event by ID",
        "description": "Returns a single event by its ID",
        "operationId": "getEventById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the event",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Event found and returned",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponseDto"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Event"
        ],
        "summary": "Update an existing event",
        "description": "Updates the event with the given ID",
        "operationId": "updateEvent",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the event to update",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventRequestDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Event updated successfully",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponseDto"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Event"
        ],
        "summary": "Delete an event",
        "description": "Deletes the event with the given ID",
        "operationId": "deleteEvent",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID of the event to delete",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Event deleted successfully"
          }
        }
      }
    },
    "/event/cities": {
      "get": {
        "tags": [
          "Event"
        ],
        "summary": "Get available Ticketmaster cities",
        "description": "Returns a list of cities for which event data can be imported",
        "operationId": "getAvailableCities",
        "responses": {
          "200": {
            "description": "Cities fetched successfully",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/event/import": {
      "post": {
        "tags": [
          "Event"
        ],
        "summary": "Import events from Ticketmaster",
        "description": "Imports external events for the specified city",
        "operationId": "importEvents",
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "description": "City to import events from",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Events imported successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EventRequestDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "imageUrl": {
            "type": "string"
          }
        },
        "description": "Event request body"
      },
      "EventResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "imageUrl": {
            "type": "string"
          }
        }
      }
    }
  }
}
