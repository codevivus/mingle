{
  "openapi": "3.0.1",
  "info": {
    "title": "OpenAPI definition",
    "version": "v0"
  },
  "tags": [
    {
      "name": "Ticket",
      "description": "Operations related to ticket management"
    }
  ],
  "paths": {
    "/ticket": {
      "get": {
        "tags": [
          "Ticket"
        ],
        "summary": "Get all tickets",
        "description": "Returns all tickets owned by the caller",
        "operationId": "getAll",
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tickets retrieved successfully",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TicketResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ticket/{id}": {
      "get": {
        "tags": [
          "Ticket"
        ],
        "summary": "Get ticket by ID",
        "description": "Retrieves one of the caller's tickets by its ID",
        "operationId": "getById",
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ticket retrieved successfully",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TicketResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Ticket"
        ],
        "summary": "Delete a ticket",
        "description": "Deletes one of the caller's tickets by its ID",
        "operationId": "delete",
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Ticket successfully deleted"
          }
        }
      }
    },
    "/ticket/add": {
      "post": {
        "tags": [
          "Ticket"
        ],
        "summary": "Create a new ticket",
        "description": "Creates a ticket for the authenticated user; any userId in the body is ignored",
        "operationId": "add",
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "X-User-Verified",
            "in": "header",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TicketRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Ticket successfully created",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/TicketResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ticket/event/{eventId}": {
      "get": {
        "tags": [
          "Ticket"
        ],
        "summary": "Get tickets by event ID",
        "description": "Retrieves the caller's own tickets for a specific event",
        "operationId": "getByEventId",
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tickets retrieved successfully",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TicketResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ticket/user/{userId}": {
      "get": {
        "tags": [
          "Ticket"
        ],
        "summary": "Get tickets by user ID",
        "description": "Retrieves the caller's tickets; only the caller's own id is accepted",
        "operationId": "getByUserId",
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tickets retrieved successfully",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TicketResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TicketRequest": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "integer",
            "format": "int64"
          },
          "userId": {
            "type": "integer",
            "format": "int64"
          },
          "imageData": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "byte"
            }
          }
        }
      },
      "EventResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "venue": {
            "type": "string"
          },
          "startTime": {
            "type": "string",
            "format": "date-time"
          },
          "endTime": {
            "type": "string",
            "format": "date-time"
          },
          "imageUrl": {
            "type": "string"
          }
        }
      },
      "TicketResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "eventResponse": {
            "$ref": "#/components/schemas/EventResponse"
          },
          "userResponse": {
            "$ref": "#/components/schemas/UserResponse"
          },
          "status": {
            "type": "string",
            "enum": [
              "VALID",
              "USED",
              "CANCELLED"
            ]
          },
          "imageData": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "byte"
            }
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "surname": {
            "type": "string"
          },
          "age": {
            "type": "integer",
            "format": "int32"
          },
          "gender": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "photoUrl": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "interests": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "datePreference": {
            "type": "string"
          },
          "relationshipGoal": {
            "type": "string"
          },
          "online": {
            "type": "boolean"
          },
          "verified": {
            "type": "boolean"
          },
          "birthDate": {
            "type": "string",
            "format": "date"
          },
          "locationLat": {
            "type": "number",
            "format": "float"
          },
          "locationLon": {
            "type": "number",
            "format": "float"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastActiveAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
