        "type": "object",
        "properties": {
          "reportedUserId": {
            "type": "integer",
            "format": "int64"
          },
          "reason": {
            "type": "string",
            "enum": [
              "SPAM",
              "HARASSMENT",
              "FAKE_PROFILE",
              "INAPPROPRIATE_CONTENT",
              "UNDERAGE",
              "OTHER"
            ]
          },
          "note": {
            "maxLength": 1000,
            "minLength": 0,
            "type": "string"
          },
          "eventId": {
            "type": "integer",
            "format": "int64"
          },
          "block": {
            "type": "boolean"
          }
        }
