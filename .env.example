# Copy to .env and fill in. Never commit .env.

# Required: HMAC signing key, at least 32 characters, e.g. `openssl rand -base64 32`
JWT_SECRET=

# Optional: enables the nightly Ticketmaster event import
TICKETMASTER_API_KEY=

# Optional overrides (defaults are for local development only)
DB_USERNAME=mingle
DB_PASSWORD=mingle_local
REDIS_PASSWORD=mingle_local

# Required: shared secret for service-to-service calls to the gateway's /internal endpoints
INTERNAL_API_KEY=

# Optional: this registered account becomes ADMIN at startup (register it first)
ADMIN_EMAIL=

# Email (verification links). Defaults use the MailHog container; its inbox is at http://localhost:8025
# For a real provider set SMTP_HOST, SMTP_PORT, SMTP_USERNAME, SMTP_PASSWORD, SMTP_AUTH=true, SMTP_STARTTLS=true, MAIL_FROM
SMTP_HOST=
APP_PUBLIC_URL=

# Production only (docker-compose.prod.yml, see docs/DEPLOYMENT.md)
DOMAIN=
CORS_ALLOWED_ORIGINS=
